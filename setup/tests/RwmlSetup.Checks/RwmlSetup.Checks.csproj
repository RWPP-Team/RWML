<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>rwml-setup-checks</AssemblyName>
    <RootNamespace>Rwml.Setup.Checks</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <Compile Include="Program.cs" />
    <Compile Include="..\..\src\RwmlSetup\GameLocator.cs" Link="GameLocator.cs" />
    <Compile Include="..\..\src\RwmlSetup\GameInstaller.cs" Link="GameInstaller.cs" />
  </ItemGroup>
  <ItemGroup Condition="'$(GameLibPath)' != ''">
    <EmbeddedResource Include="$(GameLibPath)" LogicalName="game-lib.jar" />
  </ItemGroup>
</Project>
